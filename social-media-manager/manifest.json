{
    "manifest_version": 3,
    "name": "Social Media Manager",
    "version": "1.1.0",
    "description": "TikTok & Instagram 게시물 정렬, 다운로드, 정보 오버레이",
    "permissions": [
        "storage",
        "downloads",
        "activeTab"
    ],
    "host_permissions": [
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://indown.io/*",
        "https://snap.igdl.tv/*",
        "https://igdl.tv/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.tiktok.com/*",
                "https://*.tiktok.com/*"
            ],
            "js": [
                "content/utils.js",
                "content/sorter.js",
                "content/downloader.js",
                "content/overlay.js",
                "content/tiktok-handler.js"
            ],
            "css": [
                "content/overlay.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.instagram.com/*",
                "https://*.instagram.com/*"
            ],
            "js": [
                "content/utils.js",
                "content/sorter.js",
                "content/downloader.js",
                "content/overlay.js",
                "content/instagram-handler.js"
            ],
            "css": [
                "content/overlay.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://indown.io/*"
            ],
            "js": [
                "content/indown-handler.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://snap.igdl.tv/*",
                "https://igdl.tv/*"
            ],
            "js": [
                "content/igdl-handler.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}